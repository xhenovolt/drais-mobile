# ─────────────────────────────────────────────────────────────────────────────
# DRAIS Server — configuration
#
# Copy to .env and fill in. NEVER commit .env — it holds live credentials.
# These values belong on the SERVER ONLY. Nothing here may ever be compiled
# into the Flutter app: an APK is a zip file, and anything inside it is public.
# ─────────────────────────────────────────────────────────────────────────────

# TiDB Cloud. Port is 4000, not MySQL's 3306. TLS is always on.
TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB=drais

# HTTP listener. 0.0.0.0 makes a school deployment reachable from phones
# on the same network — the same reason the desktop build binds it.
BIND_ADDRESS=0.0.0.0
PORT=8080

# development | production
NODE_ENV=development

# Mark cookies Secure. MUST be false for a school server on a plain-HTTP LAN:
# a Secure cookie over HTTP is never sent back, which presents as
# "login succeeds, then immediately signed out".
SECURE_COOKIES=false

# Session lifetime, matching the platform's 7 days.
SESSION_DAYS=7

# Connection pool. Keep it small — TiDB Cloud caps concurrent connections.
DB_POOL_SIZE=5
